{
  "name": "core-digital-shop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Core backend for a digital goods marketplace: catalog, orders, payment webhooks, automatic key delivery",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "tsx src/infrastructure/db/migrate.ts up",
    "migrate:reset": "tsx src/infrastructure/db/migrate.ts reset",
    "seed": "tsx seeds/seed.ts",
    "start:api": "tsx src/composition/main-api.ts",
    "start:worker": "tsx src/composition/main-worker.ts",
    "start:supplier": "tsx src/stubs/supplier/main.ts",
    "dev": "tsx scripts/dev-all.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:adversarial": "tsx scripts/run-tests.ts --only adversarial",
    "simulate": "tsx src/stubs/payment-simulator/cli.ts",
    "bench:catalog": "tsx scripts/bench-catalog.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "ulid": "^2.3.0",
    "undici": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
