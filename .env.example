NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

API_HOST=0.0.0.0
API_PORT=3000

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/digital_shop
DATABASE_POOL_MAX=20

ADMIN_TOKEN=dev-admin-token

